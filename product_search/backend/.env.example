DATABASE_URL=postgresql://amazon_user:amazon_password@localhost:5432/amazon_products
# Docker Compose overrides DATABASE_URL with this container-reachable address.
BACKEND_DATABASE_URL=postgresql://amazon_user:amazon_password@host.docker.internal:5432/amazon_products
BACKEND_PORT=8000
OPENAI_API_KEY=
AUTH_USERNAME=api-user
AUTH_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ISSUER=ece1508-product-search
JWT_AUDIENCE=ece1508-product-search-api
JWT_ACCESS_TOKEN_MINUTES=30
QUERY_MODEL=gpt-5.4-nano
RECOMMENDATION_MODEL=gpt-5.4-nano
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
OPENAI_TIMEOUT_SECONDS=30
DATABASE_TIMEOUT_SECONDS=5
DEFAULT_TOP_K=3
DEFAULT_CANDIDATE_LIMIT=200
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
